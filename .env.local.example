# Machine-local secret overrides.
#
# Copy this file to .env.local and keep .env.local uncommitted.
# Values here override .env, while exported shell variables still win.

# Required only for live direct RAG and answer evaluation.
OPENAI_API_KEY=

# Optional per-machine overrides:
# RDR_REPOSITORY_ROOT=/absolute/path/to/repository
# RDR_QDRANT_URL=http://localhost:6333
