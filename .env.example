# Local development settings. Copy this file to .env to override defaults.
RDR_ENVIRONMENT=local
RDR_QDRANT_URL=http://localhost:6333
RDR_QDRANT_COLLECTION=repo_chunks_v2
RDR_REPOSITORY_ROOT=.
RDR_MAX_FILE_SIZE_BYTES=1048576
RDR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RDR_EMBEDDING_DIMENSION=384
RDR_EMBEDDING_BATCH_SIZE=16
RDR_SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RDR_RETRIEVAL_MODE=dense
RDR_OPENAI_MODEL=gpt-5-mini
RDR_OPENAI_JUDGE_MODEL=gpt-5.1
RDR_RESEARCH_LIMIT=5
RDR_ANSWER_EVAL_LIMIT=5
RDR_LOG_LEVEL=INFO

# Required only for live research and answer evaluation.
OPENAI_API_KEY=

# Docker Compose Qdrant host ports.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
