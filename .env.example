# Local development settings. Copy this file to .env to override defaults.
RDR_ENVIRONMENT=local
RDR_QDRANT_URL=http://localhost:6333
RDR_QDRANT_COLLECTION=repo_chunks
RDR_REPOSITORY_ROOT=.
RDR_MAX_FILE_SIZE_BYTES=1048576
RDR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RDR_EMBEDDING_DIMENSION=384
RDR_EMBEDDING_BATCH_SIZE=16
RDR_LOG_LEVEL=INFO

# Docker Compose Qdrant host ports.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
