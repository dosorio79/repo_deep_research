# Shared local development defaults.
#
# Copy this file to .env for non-secret project defaults. Put secrets and
# machine-local overrides in .env.local instead.

# Application
RDR_ENVIRONMENT=local
RDR_LOG_LEVEL=INFO

# Repository input
RDR_REPOSITORY_ROOT=.
RDR_MAX_FILE_SIZE_BYTES=1048576

# Qdrant storage
RDR_QDRANT_URL=http://localhost:6333
RDR_QDRANT_COLLECTION=repo_chunks_v2

# Local embedding models
RDR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RDR_EMBEDDING_DIMENSION=384
RDR_EMBEDDING_BATCH_SIZE=16
RDR_SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# Retrieval defaults
RDR_RETRIEVAL_MODE=dense
RDR_RETRIEVAL_LIMIT=5

# OpenAI-backed direct RAG and answer evaluation
RDR_OPENAI_ANSWER_MODEL=gpt-5-mini
RDR_OPENAI_JUDGE_MODEL=gpt-5.1
RDR_ANSWER_EVALUATION_LIMIT=5

# Agentic research tool budgets
RDR_RESEARCH_MAX_SEARCHES=3
RDR_RESEARCH_MAX_FILE_READS=5
RDR_RESEARCH_MAX_TOTAL_TOOL_CALLS=8

# Browser frontend origins allowed to call FastAPI during local development.
RDR_CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000","http://127.0.0.1:3000"]'

# Docker Compose Qdrant host ports.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
